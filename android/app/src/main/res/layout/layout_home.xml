<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="90dp">
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ENTERPRISE DASHBOARD" android:textColor="#F8FAFC" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="20dp" android:layout_gravity="center"/>
        
        <!-- Suhu Baterai -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THERMAL TEMPERATURE" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °C" android:textColor="#38BDF8" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Bandwidth RX/TX -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginRight="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOWNLOAD (RX)" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvRx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 KB/s" android:textColor="#F8FAFC" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginLeft="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPLOAD (TX)" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvTx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 KB/s" android:textColor="#F8FAFC" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Latency Ping Local/Global -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginRight="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL PING" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvPingLocal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- ms" android:textColor="#4ADE80" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginLeft="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GLOBAL PING" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvPingGlobal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- ms" android:textColor="#F87171" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
