<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card_modern" android:padding="20dp" android:layout_marginBottom="20dp" android:elevation="4dp">
    
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvClusterName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLUSTER NAME" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="20sp"/>
            <TextView android:id="@+id/tvClusterStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Binaries Ready" android:textColor="#94A3B8" android:textSize="13sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_alignParentRight="true" android:layout_centerVertical="true">
            <Button android:id="@+id/btnClusterLogs" android:layout_width="48dp" android:layout_height="48dp" android:text=">_" android:backgroundTint="@android:color/transparent" android:textColor="#3B82F6" android:textStyle="bold" android:textSize="14sp" android:layout_marginRight="4dp"/>
            <Button android:id="@+id/btnClusterDelete" android:layout_width="48dp" android:layout_height="48dp" android:text="🗑" android:backgroundTint="@android:color/transparent" android:textColor="#EF4444" android:textSize="16sp"/>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
        <Button android:id="@+id/btnClusterInject" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="⚙️ INJECT" android:background="@drawable/bg_btn_subtle" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" android:layout_marginRight="6dp"/>
        <Button android:id="@+id/btnClusterStart" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="▶ START" android:background="@drawable/bg_btn_primary" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginHorizontal="3dp"/>
        <Button android:id="@+id/btnClusterStop" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="⏹ STOP" android:background="@drawable/bg_btn_subtle" android:textColor="#EF4444" android:textSize="12sp" android:textStyle="bold" android:layout_marginLeft="6dp"/>
    </LinearLayout>
</LinearLayout>
