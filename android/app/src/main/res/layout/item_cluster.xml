<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="16dp">
    
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvClusterName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLUSTER NAME" android:textColor="#F8FAFC" android:textStyle="bold" android:textSize="18sp"/>
            <TextView android:id="@+id/tvClusterStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Binaries Injected" android:textColor="#94A3B8" android:textSize="12sp"/>
        </LinearLayout>
        
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_alignParentRight="true" android:layout_centerVertical="true">
            <Button android:id="@+id/btnClusterDelete" android:layout_width="wrap_content" android:layout_height="40dp" android:text="DEL" android:backgroundTint="#450a0a" android:textColor="#F87171" android:textSize="10sp" android:layout_marginRight="6dp"/>
            <Button android:id="@+id/btnClusterLogs" android:layout_width="wrap_content" android:layout_height="40dp" android:text="LOGS" android:backgroundTint="#334155" android:textColor="#F8FAFC" android:textSize="10sp"/>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
        <Button android:id="@+id/btnClusterInject" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="[+] INJECT" android:backgroundTint="#0F172A" android:textColor="#38BDF8" android:textSize="12sp" android:layout_marginRight="4dp"/>
        <Button android:id="@+id/btnClusterStart" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="▶ START" android:backgroundTint="#0F172A" android:textColor="#4ADE80" android:textSize="12sp" android:layout_marginHorizontal="2dp"/>
        <Button android:id="@+id/btnClusterStop" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="■ STOP" android:backgroundTint="#0F172A" android:textColor="#F87171" android:textSize="12sp" android:layout_marginLeft="4dp"/>
    </LinearLayout>
</LinearLayout>
