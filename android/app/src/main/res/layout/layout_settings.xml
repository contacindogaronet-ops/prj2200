<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UNIVERSAL SETTINGS" android:textColor="#F8FAFC" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
    
    <Switch android:id="@+id/switchAutoRestart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto-Restart on Crash\nRespawn loop saat biner mati." android:textColor="#94A3B8" android:layout_marginBottom="20dp"/>
    
    <Switch android:id="@+id/switchWakelock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CPU Partial WakeLock\nCegah Doze/Sleep saat layar mati." android:textColor="#94A3B8" android:layout_marginBottom="20dp"/>

    <Switch android:id="@+id/switchLowLatency" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Low Latency Optimizer (Ping)\nKunci 2 Big Cores &amp; GC Delay." android:textColor="#94A3B8" android:layout_marginBottom="20dp"/>
    
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="* Perubahan parameter memerlukan restart klaster." android:textColor="#475569" android:textSize="12sp" android:layout_marginTop="30dp"/>
    
</LinearLayout>
